{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Make synthetic data",
      "type": "shell",
      "command": "python scripts/make_synthetic_data.py",
      "options": { "env": { "PYTHONPATH": "src" } },
      "problemMatcher": []
    },
    {
      "label": "Run smoke test",
      "type": "shell",
      "command": "python scripts/smoke_test.py",
      "options": { "env": { "PYTHONPATH": "src" } },
      "dependsOn": "Make synthetic data",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m pytest -q",
      "options": { "env": { "PYTHONPATH": "src" } },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
