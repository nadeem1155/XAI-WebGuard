{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Smoke test (no datasets)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke_test.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "2. Make synthetic data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/make_synthetic_data.py",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "3. Train Model A (tree)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_tree.py",
      "args": ["--config", "configs/default.yaml", "--out", "results/model_a.pkl"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "4. Train Model B (transformer, needs GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_transformer.py",
      "args": ["--config", "configs/default.yaml", "--out", "results/model_b"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "5. Evaluate detection",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_detection_eval.py",
      "args": ["--tree", "results/model_a.pkl"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "6. Evaluate explanations",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_explanation_eval.py",
      "args": ["--tree", "results/model_a.pkl", "--annotations", "data/annotations.csv"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "7. Serve API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["xai_webguard.serve.app:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "XWG_TREE": "results/model_a.pkl" },
      "console": "integratedTerminal"
    }
  ]
}
